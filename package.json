{
  "name": "react-native-optimizer",
  "version": "0.0.13",
  "description": "🚀 Production-grade CLI tool and TypeScript library for analyzing React Native projects. Detects unused imports, dead code files, and provides detailed optimization insights using Babel AST parsing.",
  "main": "dist/index.js",
  "bin": {
    "rnopt": "dist/cli.js"
  },
  "scripts": {
    "build": "npm run clean && npm run build:cli && npm run build:lib",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --outfile=dist/cli.js --minify --format=cjs",
    "build:lib": "esbuild src/index.ts --bundle --platform=node --outfile=dist/index.js --format=cjs",
    "clean": "rm -rf dist",
    "dev": "ts-node src/cli.ts",
    "lint": "tsc --noEmit",
    "release": "npm run build && npm test && standard-version",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "files": [
    "dist/",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/unit/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/__testdata__/**"
    ]
  },
  "keywords": [
    "react-native",
    "optimizer",
    "unused-imports",
    "code-analysis",
    "ast-parser",
    "typescript",
    "babel",
    "cli-tool",
    "performance",
    "code-quality",
    "dead-code",
    "bundle-analyzer"
  ],
  "author": {
    "name": "Junaid Saleem",
    "email": "junaidsaleem@tkxel.com",
    "url": "https://github.com/junaidsaleemtkxel"
  },
  "license": "MIT",
  "homepage": "https://github.com/junaidsaleemtkxel/react-native-optimizer#readme",
  "bugs": {
    "url": "https://github.com/junaidsaleemtkxel/react-native-optimizer/issues"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/chalk": "^0.4.31",
    "@types/commander": "^2.12.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.2",
    "@types/ora": "^3.1.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "esbuild": "^0.25.11",
    "jest": "^30.2.0",
    "ora": "^9.0.0",
    "standard-version": "^9.5.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/junaidsaleemtkxel/react-native-optimizer"
  }
}
